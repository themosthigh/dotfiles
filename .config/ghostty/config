# Window Configuration
window-padding-x = 4
window-padding-y = 4

# Cursor Configuration
cursor-style = block
cursor-style-blink = true

# Scrollback
scrollback-limit = 1000000

theme = "TokyoNight"

font-family = "Monaspace Neon NF"
font-family-italic = "Monaspace Radon NF"

# font-family = "Cascadia Code"
# font-family-italic = "Cascadia Code"


font-size = 8
window-inherit-font-size = false
font-feature = "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'liga'",
font-variation = wght=300
font-variation-bold = wght=800

# background configuration
background-opacity = 0.97
background-blur-radius = 7


# cell config
adjust-cell-height = 30%

macos-option-as-alt = true
